{
  "openapi": "3.1.0",
  "info": {
    "title": "shadcn-pdf",
    "description": "PDF component library for React. Provides search, installation, and documentation endpoints for AI agents and developers.",
    "version": "0.1.0",
    "contact": {
      "name": "sammykad",
      "url": "https://github.com/sammykad/shadcn-pdf"
    },
    "license": {
      "name": "MIT",
      "url": "https://github.com/sammykad/shadcn-pdf/blob/main/LICENSE"
    }
  },
  "servers": [
    {
      "url": "https://shadcn-pdf.vercel.app",
      "description": "Production"
    }
  ],
  "paths": {
    "/": {
      "get": {
        "operationId": "getHomepage",
        "summary": "Homepage",
        "description": "shadcn-pdf homepage with links to all resources.",
        "responses": {
          "200": {
            "description": "HTML homepage"
          }
        }
      }
    },
    "/llms.txt": {
      "get": {
        "operationId": "getLlmsTxt",
        "summary": "llms.txt index",
        "description": "Machine-readable index of shadcn-pdf for AI agents. Returns structured text listing all components, blocks, and resources.",
        "responses": {
          "200": {
            "description": "Plain text llms.txt",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "/llms-full.txt": {
      "get": {
        "operationId": "getLlmsFullTxt",
        "summary": "Full documentation",
        "description": "Complete shadcn-pdf documentation in plain text format for AI consumption.",
        "responses": {
          "200": {
            "description": "Full documentation text",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "/.well-known/ard.json": {
      "get": {
        "operationId": "getArdCatalog",
        "summary": "ARD discovery catalog",
        "description": "Agent Resource Discovery catalog listing all discoverable endpoints.",
        "responses": {
          "200": {
            "description": "ARD catalog JSON",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
    "/.well-known/agent-card.json": {
      "get": {
        "operationId": "getAgentCard",
        "summary": "A2A agent card",
        "description": "Agent-to-Agent protocol card describing shadcn-pdf capabilities.",
        "responses": {
          "200": {
            "description": "Agent card JSON",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
    "/.well-known/mcp/server-card.json": {
      "get": {
        "operationId": "getMcpServerCard",
        "summary": "MCP server card",
        "description": "Model Context Protocol server card with tool definitions.",
        "responses": {
          "200": {
            "description": "MCP server card JSON",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
    "/sitemap.xml": {
      "get": {
        "operationId": "getSitemap",
        "summary": "XML sitemap",
        "description": "XML sitemap listing all pages.",
        "responses": {
          "200": {
            "description": "XML sitemap",
            "content": {
              "application/xml": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "/get-started": {
      "get": {
        "operationId": "getStarted",
        "summary": "Get started guide",
        "description": "Installation and quickstart guide for shadcn-pdf.",
        "responses": {
          "200": {
            "description": "HTML get-started page"
          }
        }
      }
    },
    "/components": {
      "get": {
        "operationId": "listComponents",
        "summary": "Components listing",
        "description": "Browse all available PDF components.",
        "responses": {
          "200": {
            "description": "HTML components page"
          }
        }
      }
    },
    "/blocks": {
      "get": {
        "operationId": "listBlocks",
        "summary": "Blocks listing",
        "description": "Browse all available PDF document templates (blocks).",
        "responses": {
          "200": {
            "description": "HTML blocks page"
          }
        }
      }
    },
    "/about": {
      "get": {
        "operationId": "getAbout",
        "summary": "About page",
        "description": "About shadcn-pdf.",
        "responses": {
          "200": {
            "description": "HTML about page"
          }
        }
      }
    },
    "/privacy": {
      "get": {
        "operationId": "getPrivacy",
        "summary": "Privacy policy",
        "description": "Privacy policy for shadcn-pdf.",
        "responses": {
          "200": {
            "description": "HTML privacy page"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string",
            "description": "Error type"
          },
          "message": {
            "type": "string",
            "description": "Human-readable error message"
          },
          "links": {
            "type": "object",
            "description": "Suggested links for recovery",
            "additionalProperties": {
              "type": "string"
            }
          }
        },
        "required": ["error", "message"]
      }
    }
  }
}
