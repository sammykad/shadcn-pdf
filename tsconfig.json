{
  "compilerOptions": {
    "target": "ES2021",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": [
      "ES2021",
      "DOM"
    ],
    "jsx": "react-jsx",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "types": [
      "node"
    ],
    "outDir": "dist",
    "allowJs": true,
    "noEmit": true,
    "incremental": true,
    "tsBuildInfoFile": "node_modules/.cache/.tsbuildinfo",
    "isolatedModules": true,
    "paths": {
      "@/*": [
        "./*"
      ],
      "@/components/pdf/core/*": [
        "./registry/pdf/core/*"
      ],
      "@/components/pdf": [
        "./registry/pdf/index.ts"
      ],
      "@/components/pdf/theme": [
        "./registry/pdf/core/theme.ts"
      ],
      "@/components/pdf/palette": [
        "./registry/pdf/core/palette.ts"
      ],
      "@/components/pdf/tw": [
        "./registry/pdf/core/tw.ts"
      ],
      "@/components/pdf/fonts": [
        "./registry/pdf/core/fonts.ts"
      ],
      "@/components/pdf/provider": [
        "./registry/pdf/core/provider.tsx"
      ],
      "@/components/pdf/*": [
        "./registry/pdf/components/*"
      ]
    },
    "plugins": [
      {
        "name": "next"
      }
    ]
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
, "lib/remark-code-import.js"  ],
  "exclude": [
    "node_modules",
    "packages"
  ]
}
